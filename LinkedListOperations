	static Node inp(int val,Node head,int k) {
		if(head==null) {
			if(k==1) return new Node(val);
			return null;
		}
		if(k==1) {
			Node temp=new Node(val,head); 
			return head;
		}
		Node temp=head;
		int count=0;
		while(temp!=null) {
			count++;
			if(count==k-1) {
				Node in=new Node(val);
				in.next=temp.next;
				temp.next=in;
				break;
				
			}
			temp=temp.next;
			
		}
		return head;
	}
