import java.util.Arrays;
class Solution {
    public void rotate(int[] nums, int k) {
        int n=nums.length;
        int[] nums2=new int[n];
        k=k%n;
        int ind=0;
        for(int i=n-k;i<n;i++){
            nums2[ind]=nums[i];
            ind++;
        }
        for(int i=0;i<n-k;i++){
            nums2[ind]=nums[i];
            ind++;
        }
        for (int i = 0; i < n; i++) {
            nums[i] = nums2[i];
        }
        

        
    }
}
// more optmised approach is:-
class Solution {
    public void rev(int[] arr,int l,int r){
        while(l<r){
            int temp=arr[l];
            arr[l]=arr[r];
            arr[r]=temp;
            l++;
            r--;
        }
    }

    public void rotate(int[] nums, int k) {
        k=k%nums.length;
      
        rev(nums,nums.length-k,nums.length-1);
        rev(nums,0,nums.length-k-1);
        rev(nums,0,nums.length-1);

        
    }
}

